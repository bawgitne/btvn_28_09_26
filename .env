# ===============================
# DATABASE CONFIGURATION
# To use SQL Server, uncomment and set your SQL Server credentials below:
# ===============================
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=shopdb;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
# DB_USERNAME=sa
# DB_PASSWORD=your_password
# DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Default using in-memory H2 database for instant run:
DB_URL=jdbc:h2:mem:shopdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# ===============================
# JPA / HIBERNATE
# ===============================
DDL_AUTO=update
SHOW_SQL=false

# ===============================
# SERVER
# ===============================
SERVER_PORT=8080

# ===============================
# SMTP MAIL (for OTP Register and Forgot Password)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ===============================
# CLOUDINARY (for Product Image Upload)
# ===============================
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===============================
# ADMIN CREDENTIALS
# ===============================
ADMIN_EMAIL=trungnh@hcmute.edu.vn
ADMIN_PASSWORD=123456
